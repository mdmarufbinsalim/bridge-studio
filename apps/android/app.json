{
  "expo": {
    "name": "BridgeAudio",
    "slug": "bridge-audio",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "bridge-audio",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.bridgeaudio.mobile",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "BridgeAudio uses the camera to scan the connection QR code shown by the desktop server."
        }
      ]
    ]
  }
}
