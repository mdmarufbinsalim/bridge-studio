    "@bridge-audio/transport": "workspace:*",
    "@bridge-audio/session": "workspace:*",
    "@bridge-audio/platform-linux": "workspace:*",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/node": "^24.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.2"
  }
